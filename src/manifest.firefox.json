{
  "manifest_version": 2,
  "name": "Strongbox AutoFill (Onkay Fork)",
  "version": "1.2.6",
  "icons": {
    "128": "assets/icons/app-icon-blue-128.png"
  },
  "description": "Private personal fork of the open-source Strongbox AutoFill extension. Not affiliated with or endorsed by Phoebe Code Limited.",
  "short_name": "Strongbox Onkay",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "<all_urls>",
    "webNavigation",
    "storage"
  ],
  "author": "Onkay",
  "background": {
    "scripts": [
      "js/background.bundle.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{1af7308a-5616-4c0d-a14f-14c69f4e0bcd}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "browser_action": {
    "browser_style": true,
    "default_icon": {
      "128": "assets/icons/app-icon-blue-128.png"
    },
    "default_title": "Strongbox Onkay",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    "assets/icons/app-icon-circle.png"
  ],
  "commands": {
    "autofill-first": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "AutoFill"
    },
    "open-inline-menu": {
      "suggested_key": {
        "default": "Ctrl+Shift+O"
      },
      "description": "Show Inline Menu"
    }
  },
  "content_scripts": [
    {
      "all_frames": true,
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "js/content.bundle.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}
